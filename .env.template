# Copy this to .env and fill values (do NOT commit .env with secrets)
OPENAI_API_KEY=
FLASK_SECRET_KEY=change-me
PORT=5000

# Redis
REDIS_URL=redis://redis:6379/0

# Vector store path (inside container). The ingestion script writes index.faiss and docs.json here.
VECTOR_STORE_PATH=./vector_store

# Embedding model for OpenAI (adjust if you prefer a different model)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# How many retrieved chunks to include in each query
RAG_TOP_K=3

# Optional: TTL (in seconds) for conversation keys in Redis (default 30 days)
# REDIS_TTL_SECONDS=2592000
